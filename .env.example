# Copier ce fichier en .env, sans jamais le committer. Remplacer le jeton exposé en conversation.
DATATAXI_API_BASE=https://n8n.xtream.space/webhook/datataxi-api
DATATAXI_READ_TOKEN=REMPLACER_PAR_UN_NOUVEAU_JETON
ZONEPREDICT_TIMEZONE=America/Toronto
ZONEPREDICT_DB=/data/zonepredict_dashboard.sqlite3
ZONEPREDICT_MAX_ROWS_PER_DAY=5000
ZONEPREDICT_MAX_DAYS_INITIAL=90
ZONEPREDICT_POLL_MINUTES=5
ZONEPREDICT_INITIAL_BACKFILL=0
# Clé partagée avec le proxy Vercel (>= 24 caractères, générée : openssl rand -hex 32). Vide = API ouverte (Nginx seul).
ZONEPREDICT_PROXY_KEY=
